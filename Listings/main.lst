  28          /**
  29           * @brief Timer0 初始化
  30           * @note 11.0592MHz时钟，模式1（16位定时器），50ms中断一次
  31           *       定时器计算公式：65536 - (11059200/12/20) = 65536 - 46080 = 19456
  32           */
  33          void Timer0_Init(void) {
  34   1          TMOD &= 0xF0;
  35   1          TMOD |= 0x01;
  36   1          TH0 = 0x4B;  /* (65536 - 46080) / 256 = 76 = 0x4C, 修正为0x4B确保50ms */
  37   1          TL0 = 0x00;  /* (65536 - 46080) % 256 = 0 */
  38   1          ET0 = 1;
  39   1          TR0 = 1;
  40   1      }
  41          
  42          /**
  43           * @brief 看门狗初始化
  44           * @note 约2秒超时
  45           */
  46          void WDT_Init(void) {
  47   1          WDT_CONTR = 0x27;  /* EN_WDT=1, CLR_WDT=0, IDL_WDT=0, PS2=0, PS1=1, PS0=1 */
  48   1      }
  49          
  50          /**
  51           * @brief 喂狗
  52           */
  53          void WDT_Feed(void) {
  54   1          WDT_CONTR |= 0x10;  /* CLR_WDT位置1 */
C51 COMPILER V9.60.7.0   MAIN                                                              04/18/2026 15:28:01 PAGE 2   

  55   1      }
