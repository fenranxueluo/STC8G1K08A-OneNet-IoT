 153          /**
 154           * @brief Timer0中断服务程序
 155           * @note 每50ms进入一次，仅设置标志位，不执行耗时操作
 156           */
 157          void Timer0_ISR(void) interrupt 1 {
 158   1          static unsigned char tick_count = 0;
 159   1      
 160   1          TH0 = 0x4B;
 161   1          TL0 = 0x00;
 162   1      
 163   1          tick_count++;
 164   1          if (tick_count >= 80) {  /* 80 * 50ms = 4000ms = 4秒 */
 165   2              tick_count = 0;
 166   2              g_dht11_ready = 1;
 167   2          }
 168   1          
 169   1          /* 看门狗计数 */
 170   1          wdt_counter++;
 171   1          if (wdt_counter >= 30) {  /* 1.5秒必须喂狗一次 */
 172   2              WDT_Feed();
 173   2              wdt_counter = 0;
 174   2          }
 175   1      }


