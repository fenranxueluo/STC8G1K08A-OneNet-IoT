  57          /**
  58           * @brief 显示错误信息
  59           */
  60          static void ShowError(unsigned char error_code) {
  61   1          OLED_Clear();
  62   1          OLED_ShowString(0, 0, "Error:");
  63   1          if (error_code & ERROR_WIFI_INIT) {
  64   2              OLED_ShowString(0, 2, "WiFi Failed");
  65   2          }
  66   1          if (error_code & ERROR_MQTT_CONN) {
  67   2              OLED_ShowString(0, 4, "MQTT Failed");
  68   2          }
  69   1      }
  70          
  71          /**
  72           * @brief 主函数
  73           */
  74          void main(void) {
  75   1          unsigned char wifi_retry = 0;
  76   1          
  77   1          /* GPIO初始化 */
  78   1          /* P3.2 - DHT11数据线（输入模式） */
  79   1          P3M0 &= ~(1 << 2);
  80   1          P3M1 |= (1 << 2);
  81   1          /* P3.3 - LED控制（推挽输出） */
  82   1          P3M0 |= (1 << 3);
  83   1          P3M1 &= ~(1 << 3);
  84   1          /* P5.4/P5.5 - I2C OLED（准双向模式） */
  85   1          P5M0 &= ~0x30;
  86   1          P5M1 &= ~0x30;
  87   1      
  88   1          UART_Init();
  89   1          OLED_Init();
  90   1          Timer0_Init();
  91   1          WDT_Init();
  92   1          EA = 1;
  93   1      
  94   1          /* 初始化显示 */
  95   1          OLED_ShowString(0, 0, "Init...");
  96   1          
  97   1          /* WiFi初始化，带重试 */
  98   1          for (wifi_retry = 0; wifi_retry < 3; wifi_retry++) {
  99   2              if (ESP8266_Init()) {
 100   3                  break;
 101   3              }
 102   2              Delay_ms(2000);
 103   2          }
 104   1          
 105   1          if (wifi_retry >= 3) {
 106   2              g_system_error |= ERROR_WIFI_INIT;
 107   2              ShowError(g_system_error);
 108   2              /* 继续运行，尝试离线模式 */
 109   2          } else {
 110   2              /* 订阅控制主题 */
 111   2              if (!ESP8266_SubscribeSetTopic()) {
 112   3                  g_system_error |= ERROR_MQTT_CONN;
 113   3              }
 114   2          }
 115   1      
 116   1          OLED_Clear();
C51 COMPILER V9.60.7.0   MAIN                                                              04/18/2026 15:28:01 PAGE 3   

 117   1          OLED_ShowString(0, 0, "Temp: ");
 118   1          OLED_ShowString(0, 2, "Hum: ");
 119   1      
 120   1          while (1) {
 121   2              /* LED控制 */
 122   2              P33 = led_state;
 123   2      
 124   2              /* DHT11数据采集任务 */
 125   2              if (g_dht11_ready) {
 126   3                  g_dht11_ready = 0;
 127   3      
 128   3                  if (DHT11_Read(&dht_data)) {
 129   4                      /* 整数运算替代float，结果放大10倍 */
 130   4                      g_temp_x10 = dht_data.temp_int * 10 + dht_data.temp_dec;
 131   4                      g_hum_x10 = dht_data.hum_int * 10 + dht_data.hum_dec;
 132   4                      g_data_updated = 1;
 133   4      
 134   4                      /* 更新OLED显示 */
 135   4                      OLED_ShowIntWithDecimal(40, 0, g_temp_x10, 2);
 136   4                      OLED_ShowIntWithDecimal(40, 2, g_hum_x10, 2);
 137   4      
 138   4                      /* 上传数据到OneNet（仅在无错误时） */
 139   4                      if (g_system_error == 0) {
 140   5                          ESP8266_PublishMessage(g_temp_x10, g_hum_x10);
 141   5                      }
 142   4                  } else {
 143   4                      g_system_error |= ERROR_SENSOR_READ;
 144   4                  }
 145   3                  
 146   3                  /* 喂狗 */
 147   3                  WDT_Feed();
 148   3                  wdt_counter = 0;
 149   3              }
 150   2          }
 151   1      }
