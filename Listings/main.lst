  16          volatile int g_temp_x10 = 0;
  17          volatile int g_hum_x10 = 0;
  18          
  19          /* 系统状态 */
  20          volatile unsigned char g_system_error = 0;
  21          #define ERROR_WIFI_INIT     0x01
  22          #define ERROR_MQTT_CONN     0x02
  23          #define ERROR_SENSOR_READ   0x04
  24          
  25          /* 看门狗喂狗周期计数 */
  26          static unsigned char wdt_counter = 0;
